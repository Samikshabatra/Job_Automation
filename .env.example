# Copy to .env and fill in. .env is gitignored; this file is not.

# Gemini, used for resume tailoring.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash. Note that retired models can still
# appear in ListModels while generateContent returns 404 for newer keys.
GEMINI_MODEL=gemini-3.5-flash

# Adzuna, used for job discovery.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# The address applications are submitted under.
APPLICANT_EMAIL=

# Optional. Only needed when the typst binary is not on PATH, e.g.
# TYPST_BIN=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\Typst.Typst_...\typst.exe
TYPST_BIN=
